APP_NAME="FlexiRent"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
CACHE_STORE=file
# No queue worker process runs in this environment (see README > Known
# compromises), so queued mail (WelcomeMail, TransactionalMail, ContractMail)
# must be dispatched synchronously. Switch to "database" (or another driver)
# and run `php artisan queue:work` once a worker process is available.
QUEUE_CONNECTION=sync

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flexirent
DB_USERNAME=root
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@flexirent.rw"
MAIL_FROM_NAME="${APP_NAME}"

# Mobile money and SMS integrations below are prepared but not yet active:
# no controller currently calls out to these providers, and payments are
# recorded manually by an admin (see README > Known compromises). Fill
# these in only once real MTN MoMo / Airtel Money / SMS gateway
# integration work begins.
MTN_MOMO_MERCHANT_NUMBER=
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
AIRTEL_MONEY_MERCHANT_NUMBER=
AIRTEL_MONEY_API_KEY=

SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=

# ------------------------------------------------------------------
# Railway production (UAT deployment) — reference only, commented out.
# Set these as actual environment variables in the Railway dashboard
# (or `railway variables set`), not by copying this file as-is. Never
# put real secret values in this .env.example file itself.
# ------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://<your-railway-app>.up.railway.app
#
# Security: cookies only over HTTPS, session data encrypted at rest.
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
#
# Demo-only Mobile Money "confirm on your phone" simulation. When true,
# a client can mark their own MoMo payment as paid with no real money.
# Keep false in production; turn on only for a supervised demo.
# MOMO_SIMULATION=false
#
# Provided automatically when you attach a Railway MySQL plugin — copy
# them from its "Variables" tab instead of typing them by hand:
# DB_CONNECTION=mysql
# DB_HOST=<railway-mysql-host>
# DB_PORT=<railway-mysql-port>
# DB_DATABASE=<railway-mysql-database>
# DB_USERNAME=<railway-mysql-username>
# DB_PASSWORD=<railway-mysql-password>
#
# Real SMTP credentials so verification/notification emails actually
# reach real UAT testers:
# MAIL_MAILER=smtp
# MAIL_HOST=<smtp-host>
# MAIL_PORT=587
# MAIL_USERNAME=<smtp-username>
# MAIL_PASSWORD=<smtp-password>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=<no-reply@your-domain>
# MAIL_FROM_NAME="${APP_NAME}"
#
# The real administrator account for this deployment (see AdminSeeder;
# deliberately not given a default value even here, same as in local .env):
# ADMIN_EMAIL=<real-admin-email>
# ADMIN_PASSWORD=<real-admin-password>
#
# Left blank unless mobile money / SMS integration goes live for this
# deployment too (see the "prepared but not active" note above):
# MTN_MOMO_MERCHANT_NUMBER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_API_SECRET=
# AIRTEL_MONEY_MERCHANT_NUMBER=
# AIRTEL_MONEY_API_KEY=
# SMS_GATEWAY_URL=
# SMS_GATEWAY_KEY=
